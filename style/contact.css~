:root{
    --main-width:100%;
    --main-height:100vh;
    --main-color:#c9ff00;
    --second-color:#ffffff;
    --third-color:#000000FF;
}
html, body {
    overflow-x: hidden;
}
body{
    overflow: hidden;
    background: var(--third-color);
    margin: 0;
    padding: 0;
    position: relative;
}
section{
    width: 100%;
    height: 170vh;
    position: relative;
}

